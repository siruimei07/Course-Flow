{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".test-dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/shared/**/*.ts",
    "src/data/**/*.ts",
    "src/main/runtime-paths.ts",
    "src/renderer/global.d.ts",
    "tests/**/*.ts"
  ]
}
