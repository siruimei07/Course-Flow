LOG_LEVEL=info

DATABASE_URL=postgresql://courseflow:courseflow-local-password@127.0.0.1:54329/courseflow_dev

OBJECT_STORE_ENDPOINT=http://127.0.0.1:4566
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=courseflow-dev
OBJECT_STORE_ACCESS_KEY=courseflow-local
OBJECT_STORE_SECRET_KEY=courseflow-local-secret
OBJECT_STORE_FORCE_PATH_STYLE=true
APP_ORIGIN=http://127.0.0.1:3000

WEB_PORT=3000
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Replace only the AuthSessionPort adapter in apps/web/composition/runtime.ts when a provider is selected.
AUTH_MODE=development
AUTH_DEVELOPMENT_SUBJECT=development:courseflow-local-user
AUTH_DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_DEVELOPMENT_DISPLAY_NAME=CourseFlow Student
AUTH_DEVELOPMENT_TIME_ZONE=Asia/Shanghai
