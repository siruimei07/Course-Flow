# Mutable visual sandbox used during design conversations. When approved, copy
# an exact snapshot into docs/design/baselines/<version>/; this root file remains
# local and mutable, so it is never the authoritative frozen baseline.
/courseflow-visual-lab.html
/courseflow-element-style-lab.html
/courseflow-visual-lab-glass.html

# Local configuration and generated dependency state.
.env
.env.*
!.env.example
node_modules/
node_modules.p0-*/
.p0-tmp/
.pnpm-store/

# Build, test, and tool output.
.next/
dist/
coverage/
playwright-report/
test-results/

*.tsbuildinfo

# Local editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Workspace build and local state
/apps/*/.next/
